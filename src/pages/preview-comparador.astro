---
/**
 * Página temporal de QA visual para la evidencia de un Case (EPIC 3.6.1;
 * reencauzada por la access layer en EPIC 7 — Checkpoint 7.2). No se enlaza
 * desde el nav ni desde ninguna otra página. Se elimina (o se decide conservar)
 * cuando exista /trabajos/[slug] y la evidencia se renderice ahí en contexto
 * real.
 *
 * Ya no consulta `astro:content` directamente. src/lib/content/cases.ts es el
 * único punto de acceso a la colección (regla de dependencia, ver CLAUDE.md), y
 * saltárselo tenía una consecuencia concreta y no solo estilística: getEntry()
 * ignora `draft`, así que esta ruta podía renderizar —y emitir a `dist/`— un
 * caso explícitamente no publicado. Con getPublishedCaseById() un caso en
 * borrador hace fallar el build aquí, en vez de publicarse por la puerta de
 * atrás.
 *
 * Sigue siendo `noindex` (BaseLayout emite noindex, nofollow): esto es una
 * superficie de QA, no una página pública.
 *
 * Muestra la evidencia a través de CaseEvidence y no del comparador directo,
 * para que lo que se revisa aquí sea exactamente lo que compone el sitio,
 * incluida la rama de sola fotografía de resultado.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import CaseEvidence from '../components/cases/CaseEvidence.astro';
import { getPublishedCaseById } from '../lib/content/cases';

const caseEntry = await getPublishedCaseById('limpieza-profunda-lavadora');
if (!caseEntry) {
  throw new Error('Caso piloto no encontrado o en borrador: limpieza-profunda-lavadora');
}
---

<BaseLayout title="Preview — Comparador" noindex>
  <Section spacing="lg">
    <h1 class="text-ink text-2xl font-bold md:text-3xl">{caseEntry.data.title}</h1>
    <p class="text-ink-2 mt-2 max-w-prose">{caseEntry.data.shortDescription}</p>

    <div class="mt-8 max-w-2xl">
      <CaseEvidence evidence={caseEntry.data.evidence} title={caseEntry.data.title} />
    </div>
  </Section>
</BaseLayout>

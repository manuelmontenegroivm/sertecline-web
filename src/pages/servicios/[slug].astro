---
import { render } from 'astro:content';
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { getPublishedServices, getServiceBySlug } from '../../lib/content/services';
import { getRelatedCases } from '../../lib/content/cases';
import { services as serviceCatalog } from '../../data/services';
import { servicesWithAccreditations } from '../../data/accreditations';

export async function getStaticPaths() {
  const services = await getPublishedServices();

  return services.map((service) => ({
    params: { slug: service.id },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error('Missing service slug');
}

const service = await getServiceBySlug(slug);

if (!service) {
  throw new Error(`Published service not found for slug: ${slug}`);
}

const catalogEntry = serviceCatalog.find((entry) => entry.id === service.id);
const title = catalogEntry?.title ?? service.id;
const seoTitle = catalogEntry?.seoTitle;
const { intro, metaDescription, faqs } = service.data;
const { Content } = await render(service);

// Sin condicionales por slug: la relación la declara cada caso en su propio
// frontmatter (`service`), así que esta línea sirve igual a los servicios del
// catálogo y a los que se agreguen.
//
// Se piden TODOS los casos publicados del servicio y ya no uno solo (EPIC 7 —
// Checkpoint 7.3). El `limit: 1` anterior descartaba en silencio cualquier otro
// trabajo real publicado de ese servicio: la consulta decidía qué quedaba
// invisible. Ahora la ruta entrega la colección completa y el layout decide qué
// muestra completo y qué enlaza — una decisión de presentación, tomada donde se
// ve y auditable.
const relatedCases = await getRelatedCases(service.id);

// Misma división que `relatedCases` y `faqs`: la ruta resuelve el dato, el
// layout compone. La pertinencia por servicio se decide en un único lugar
// auditable (src/data/accreditations.ts#servicesWithAccreditations) y no con
// un condicional por slug repartido entre componentes.
//
// `.some()` y no `.includes()`: la lista está tipada como `readonly ServiceId[]`
// (unión de literales derivada del catálogo), así que `.includes()` exigiría un
// `ServiceId` como argumento y `service.id` —el id de la entrada de colección—
// es `string`. Comparar con `===` no necesita ese estrechamiento y no cuesta un
// `as`: un cast aquí silenciaría justamente la validación que este tipo aporta.
const showAccreditations = servicesWithAccreditations.some((id) => id === service.id);
---

<ServiceLayout
  title={title}
  seoTitle={seoTitle}
  intro={intro}
  metaDescription={metaDescription}
  faqs={faqs}
  relatedCases={relatedCases}
  showAccreditations={showAccreditations}
>
  <Content />
</ServiceLayout>

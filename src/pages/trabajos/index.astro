---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import CaseCard from '../../components/cases/CaseCard.astro';
import { getPublishedCases } from '../../lib/content/cases';
import { buildBreadcrumbStructuredData, buildCanonicalUrl } from '../../lib/seo/page';
import type { Breadcrumb } from '../../types/breadcrumb';

// El h1 de esta página. Constante local y no literal repetido: dentro de este
// archivo lo imprimen el <title>, el <h1> y el último tramo del rastro, y son
// la misma denominación, no tres decisiones.
const HEADING = 'Trabajos realizados';

const INTRO =
  'Trabajos que Sertecline realizó a domicilio, cada uno con la fotografía de su resultado y el servicio al que corresponde.';

const META_DESCRIPTION =
  'Trabajos realizados por Sertecline a domicilio en Santiago, con fotografías reales y el servicio técnico al que corresponde cada uno.';

const EMPTY = 'Todavía no hay trabajos publicados en esta página.';

const cases = await getPublishedCases();

// Dos niveles, igual que una ficha de servicio: la home y esta página. El
// último tramo no lleva href — es la página actual (ver src/types/breadcrumb.ts).
const breadcrumbs: Breadcrumb[] = [{ name: 'Inicio', href: '/' }, { name: HEADING }];

// Mismo array que el <ol> de <Breadcrumbs>, mismo builder que las fichas de
// servicio — ver lib/seo/page.ts.
const canonical = buildCanonicalUrl(Astro.url.pathname, Astro.site);
const structuredData = buildBreadcrumbStructuredData(breadcrumbs, canonical);
---

<BaseLayout title={HEADING} description={META_DESCRIPTION} canonical={canonical}>
  {
    structuredData && (
      <script type="application/ld+json" slot="head" is:inline set:html={structuredData} />
    )
  }
  <header class="bg-paper">
    <Container size="content" class="pt-10 pb-8 md:pt-16 md:pb-12">
      <Breadcrumbs items={breadcrumbs} class="mb-6" />
      <h1 class="text-ink text-display font-black tracking-tighter">{HEADING}</h1>
      <p class="text-ink-2 mt-4 max-w-prose text-lg leading-relaxed md:mt-6">{INTRO}</p>
    </Container>
  </header>

  <Container size="content" class="pt-0 pb-16 md:pb-24">
    {
      cases.length > 0 ? (
        <div class="flex flex-col gap-16 md:gap-24">
          {cases.map((caseEntry) => (
            <CaseCard case={caseEntry} />
          ))}
        </div>
      ) : (
        <p class="text-ink-2 max-w-prose text-lg">{EMPTY}</p>
      )
    }
  </Container>
</BaseLayout>

---
/**
 * Nav desktop + trigger móvil. Renderiza únicamente `availableNav`: mientras
 * ningún ítem tenga destino real, no se muestra nada (ni links ni hamburguesa)
 * — ver EPIC 3.5.
 *
 * PÁGINA ACTUAL. Las dos navegaciones marcan el destino actual con la misma
 * regla —coincidencia exacta, indiferente a la barra final— que vive en un
 * único lugar (src/lib/utils/navigation.ts), de modo que desktop y móvil no
 * pueden decir cosas distintas según el ancho de la pantalla. Cada componente
 * la aplica sobre `Astro.url.pathname` en build; no se descubre la navegación
 * en runtime, así que la marca es correcta desde el HTML servido.
 *
 * Hasta EPIC 8 — Checkpoint 8.2 este archivo resolvía además el `href` actual y
 * se lo pasaba a <MobileMenu> como prop, porque el menú era un island de React
 * que no podía leer el pathname del build. Desde CP 8.3 el menú es un
 * componente de Astro (ver MobileMenu.astro, F-04) y lo resuelve por su cuenta:
 * el nav ya no serializa estado para nadie ni monta ninguna island.
 */
import NavLink from './NavLink.astro';
import MobileMenu from './MobileMenu.astro';
import { availableNav } from '../../data/navigation';
---

{
  availableNav.length > 0 && (
    <>
      <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
        {availableNav.map((item) => (
          <NavLink item={item} />
        ))}
      </nav>
      <MobileMenu />
    </>
  )
}

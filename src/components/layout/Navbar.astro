---
/**
 * Nav desktop + trigger móvil. Renderiza únicamente `availableNav`: mientras
 * ningún ítem tenga destino real, no se muestra nada (ni links ni hamburguesa)
 * — ver EPIC 3.5.
 *
 * PÁGINA ACTUAL EN MÓVIL (EPIC 8 — Checkpoint 8.2). El destino actual se
 * resuelve aquí, en Astro, que ya conoce el pathname del build, y viaja al
 * island como un dato: MobileMenu solo lo renderiza. No se descubre la
 * navegación en runtime —nada de `window.location`—, así que la marca es
 * correcta desde el HTML servido y no depende de que la hidratación ocurra;
 * tampoco se envía al cliente la regla de coincidencia.
 *
 * Se pasa el `href` del ítem actual y no un `pathname`: es el island renderizando
 * una comparación de igualdad, no reimplementando la semántica. Esa semántica
 * —coincidencia exacta, indiferente a la barra final— vive en un único lugar
 * (lib/utils/navigation.ts) y es exactamente la misma que aplica <NavLink> al
 * lado, de modo que desktop y móvil no pueden marcar destinos distintos.
 */
import NavLink from './NavLink.astro';
import MobileMenu from './MobileMenu';
import { availableNav } from '../../data/navigation';
import { isCurrentNavItem } from '../../lib/utils/navigation';

// `undefined` cuando ninguno coincide —una ficha de servicio, la ficha de un
// trabajo—, y entonces el panel móvil no marca nada, igual que el nav desktop.
const currentHref = availableNav.find((item) =>
  isCurrentNavItem(Astro.url.pathname, item.href)
)?.href;
---

{
  availableNav.length > 0 && (
    <>
      <nav aria-label="Principal" class="hidden items-center gap-8 md:flex">
        {availableNav.map((item) => (
          <NavLink item={item} />
        ))}
      </nav>
      <MobileMenu items={availableNav} currentHref={currentHref} client:load />
    </>
  )
}

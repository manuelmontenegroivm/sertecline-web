---
/**
 * Un `<details>/<summary>` nativo por pregunta — sin React ni Framer Motion:
 * el disclosure no necesita estado real (regla de React en CLAUDE.md), y a
 * diferencia de un acordeón con JS, la respuesta queda en el DOM inicial
 * aunque esté colapsada (clave para AEO/GEO: crawlers y asistentes de IA la
 * leen igual). El `<h3>` dentro de `<summary>` es válido por HTML spec
 * (summary acepta un heading como primer hijo) y le da a cada pregunta
 * jerarquía de encabezado real para SEO/GEO.
 * Sin `border`/`shadow`/fondo propio (mismo criterio que ServiceCard.astro):
 * la separación la da el `border-t` + el gap de la lista contenedora.
 *
 * Reparto de responsabilidades entre los dos elementos (CP 5.5): `<details>`
 * aporta solo el hairline separador; TODO el padding vertical vive en
 * `<summary>`, porque `summary` es el único elemento activable. Con el padding
 * en `<details>` la fila medía 67px pero solo 27px respondían al toque: los
 * 20px de aire sobre y bajo la pregunta parecían parte del trigger y no lo
 * eran. Manteniendo `py-5` —ahora dentro de summary— la fila cerrada se ve
 * idéntica y pasa a ser tappable de extremo a extremo (>=44px sin necesidad de
 * `min-height`: 20 + línea + 20 ya lo supera).
 * El cierre inferior del bloque abierto lo pone `pb-5` en el `<p>`, no un
 * padding en `<details>`: así ese aire existe solo cuando hay respuesta
 * visible y no vuelve a añadir superficie muerta bajo la pregunta cerrada.
 * El foco lo aporta la regla global `:focus-visible` de src/styles/brand.css
 * (mismo criterio que Button/ButtonLink/ServiceCard: no duplicar el token de
 * foco); ahora dibuja el contorno sobre la fila completa, que es exactamente
 * el área que responde al clic.
 */
import { ChevronDown } from '@lucide/astro';

interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props as Props;
---

<details class="group border-hairline border-t">
  <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-5">
    <h3 class="text-ink text-base font-bold md:text-lg">{question}</h3>
    <ChevronDown
      class="text-ink-2 size-[var(--icon-md)] shrink-0 transition-transform duration-200 group-open:rotate-180 motion-reduce:transition-none"
      stroke-width={1.75}
      aria-hidden="true"
    />
  </summary>
  <p class="text-ink-2 max-w-prose pb-5">{answer}</p>
</details>

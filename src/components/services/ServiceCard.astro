---
import ServiceIcon from './ServiceIcon.astro';
import type { Service } from '../../data/services';

interface Props {
  service: Service;

  href?: string;
}

const { service, href } = Astro.props as Props;

// Ver el bloque sobre la flecha, arriba. `titleLead` queda vacío en un título
// de una sola palabra; el espacio sobrante se colapsa al inicio de la línea.
const titleWords = service.title.split(' ');
const titleLead = titleWords.slice(0, -1).join(' ');
const titleTail = titleWords[titleWords.length - 1];
---

<article
  class:list={[
    'border-hairline grid grid-cols-[auto_1fr] content-start gap-x-4 border-t py-6',
    href && [
      'group relative transition-colors [transition-duration:var(--duration-micro)] motion-reduce:transition-none',
      'hover:border-hairline-strong focus-within:border-hairline-strong',
    ],
  ]}
>
  <ServiceIcon name={service.icon} class="text-brand-ink mt-1 size-[var(--icon-2xl)] self-start" />

  <h3 class="text-ink text-xl font-bold md:text-2xl">
    {
      href ? (
        <a
          href={href}
          class="group-hover:text-brand-ink transition-colors [transition-duration:var(--duration-fast)] after:absolute after:inset-0 motion-reduce:transition-none"
        >
          <span class="underline-offset-4 group-hover:underline">
            {titleLead}{' '}
            <span class="whitespace-nowrap">
              {titleTail}
              <svg
                class="text-ink-3 group-hover:text-brand-ink group-focus-within:text-brand-ink inline-block size-[var(--icon-sm)] align-middle transition-[translate,color] [transition-duration:var(--duration-fast)] [transition-timing-function:var(--ease-out)] motion-safe:group-focus-within:translate-x-0.5 motion-safe:group-hover:translate-x-0.5 motion-reduce:transition-none"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
              </svg>
            </span>
          </span>
        </a>
      ) : (
        service.title
      )
    }
  </h3>

  <p class="text-ink-2 col-start-2 mt-3 max-w-prose text-base">{service.shortDescription}</p>
</article>

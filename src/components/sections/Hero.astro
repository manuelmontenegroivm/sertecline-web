---
/**
 * Primera sección visible del sitio. Sin subcomponentes: badge, h1, subtítulo
 * y CTAs no tienen consumidor propio fuera de este archivo (ver EPIC 3.5).
 *
 * CTAs (EPIC 4.1 — Checkpoint 4.1.8): son enlaces reales, no botones. Cubren
 * los dos estados con que se llega a home —listo para escribir, o todavía
 * evaluando—: acción comercial y exploración. Deliberadamente NO reutilizan
 * <ContactActions>: ese componente es el par cerrado WhatsApp + llamada y
 * además asume fondo `paper-2` para su override del botón secundario (ver ese
 * archivo); esta sección es `paper`, donde ese override lo dejaría del mismo
 * color que el fondo. Lo que sí se comparte es la primitiva correcta,
 * <ButtonLink>, y el enlace de WhatsApp derivado del NAP.
 *
 * El href de WhatsApp se calcula en build con buildWhatsappHref(), sin
 * argumentos: el mensaje genérico tiene una sola fuente (lib/utils/contact.ts)
 * y es el mismo que usa la sección Contacto. Aquí no se escribe el número, ni
 * el dominio wa.me, ni el encoding.
 *
 * El secundario es un ancla de la propia página, no una ruta: `#servicios`
 * existe en Services.astro, que ya trae `scroll-mt-24` para el header sticky, y
 * el desplazamiento suave es la regla global de brand.css, gateada por
 * prefers-reduced-motion. Sin JS de cliente: la sección no hidrata nada.
 * Se usa el fragmento puro y no `/#servicios` (la forma de navigation.ts, que
 * necesita el prefijo porque el header también aparece en las fichas): el hero
 * solo existe en home, así que el salto es dentro del mismo documento.
 */
import Section from '../layout/Section.astro';
import Badge from '../ui/Badge.astro';
import ButtonLink from '../ui/ButtonLink.astro';
import VisuallyHidden from '../ui/VisuallyHidden.astro';
import { heroContent } from '../../data/hero';
import { buildWhatsappHref } from '../../lib/utils/contact';

const whatsappHref = buildWhatsappHref();
---

<Section as="section" background="paper" spacing="lg">
  <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-16">
    <div class="flex flex-col items-start gap-6">
      <Badge>{heroContent.badge}</Badge>

      <h1 class="text-ink text-3xl font-black tracking-tighter md:text-6xl">
        {heroContent.title}
      </h1>

      <p class="text-ink-2 max-w-prose text-lg">
        {heroContent.subtitle}
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <ButtonLink
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="lg"
        >
          {heroContent.primaryCtaLabel}
          <VisuallyHidden>(abre en una pestaña nueva)</VisuallyHidden>
        </ButtonLink>
        <ButtonLink href="#servicios" variant="outline" size="lg">
          {heroContent.secondaryCtaLabel}
        </ButtonLink>
      </div>
    </div>

    <!-- Espacio reservado para fotografía real (futura épica de assets) -->
    <div
      class="border-hairline bg-paper-2 aspect-[4/3] w-full rounded-2xl border"
      aria-hidden="true"
    >
    </div>
  </div>
</Section>

---
import Section from '../layout/Section.astro';
import EditorialSplit from '../layout/EditorialSplit.astro';
import TechnicalNote from '../ui/TechnicalNote.astro';
import CaseResultImage from '../cases/CaseResultImage.astro';
import { getPublishedCaseById } from '../../lib/content/cases';
import { featuredWorkContent } from '../../data/featuredWork';
import ButtonLink from '../ui/ButtonLink.astro';
import VisuallyHidden from '../ui/VisuallyHidden.astro';
import { heroContent } from '../../data/hero';
import { technicianAccreditations } from '../../data/accreditations';
import { buildWhatsappHref } from '../../lib/utils/contact';

// CP 9.2: temporary approved evidence; the final hero asset belongs to CP 9.3.
const referenceCase = await getPublishedCaseById(featuredWorkContent.caseId);
const whatsappHref = buildWhatsappHref();
---

<Section as="section" background="paper" spacing="sm">
  <EditorialSplit>
    <div class="flex flex-col items-start gap-6">
      <p class="text-brand-ink text-sm font-semibold">{heroContent.badge}</p>

      <h1
        class="text-ink max-w-narrow text-display leading-[1.05] font-black tracking-tighter text-balance"
      >
        {heroContent.title}
      </h1>

      <p class="text-ink-2 max-w-prose text-lg">
        {heroContent.subtitle}
      </p>

      <div
        class="flex w-full flex-col items-start gap-3 sm:w-auto sm:flex-row sm:items-center sm:gap-4"
      >
        <ButtonLink
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="primary"
          size="lg"
          class="w-full sm:w-auto"
        >
          {heroContent.primaryCtaLabel}
          <VisuallyHidden>(abre en una pestaña nueva)</VisuallyHidden>
        </ButtonLink>
        <ButtonLink href="#servicios" variant="outline" size="md">
          {heroContent.secondaryCtaLabel}
        </ButtonLink>
      </div>

      <div class="border-hairline max-w-narrow flex w-full flex-col gap-2 border-t pt-6">
        <p class="text-ink-2 text-sm">{heroContent.trustNote}</p>
        <ul class="flex flex-col gap-x-8 gap-y-1 sm:flex-row sm:flex-wrap">
          {
            technicianAccreditations.map((accreditation) => (
              <li class="text-ink text-sm font-medium">{accreditation}</li>
            ))
          }
        </ul>
      </div>
    </div>
    {
      referenceCase && (
        <figure slot="media" class="flex flex-col gap-4">
          <CaseResultImage
            result={referenceCase.data.evidence.result}
            title={referenceCase.data.title}
            resultAlt={referenceCase.data.evidence.resultAlt}
            width={384}
            widths={[384, 720]}
            sizes="(min-width: 26rem) 24rem, calc(100vw - 2rem)"
            loading="eager"
            fetchpriority="high"
            class="rounded-photo h-auto w-full"
          />
          <TechnicalNote as="figcaption">{referenceCase.data.title} · Resultado</TechnicalNote>
        </figure>
      )
    }
  </EditorialSplit>
</Section>

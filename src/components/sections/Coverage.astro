---
/**
 * Sección "Cobertura" (EPIC 3.8). Vive debajo de "Servicios" en home.
 *
 * Muestra una selección editorial de áreas, no el catálogo completo (EPIC 4.1 —
 * Checkpoint 4.1.4): src/data/areas.ts declara las 41 entidades cubiertas y
 * src/data/coverageSection.ts#featuredAreaIds elige cuáles se listan y en qué
 * orden. Este componente no filtra ni ordena — en particular no debe derivar
 * nada de `area.priority`, que es un dato comercial interno (ver areas.ts).
 *
 * Reutiliza Badge.astro por área: son etiquetas de texto no interactivas, así
 * que no se justifica un componente propio todavía. Cuando exista
 * /comunas/[id], este es el único archivo que cambia para envolver cada Badge
 * en un <a href={`/comunas/${area.id}`}>.
 *
 * `scroll-mt-24` compensa el header sticky al navegar por ancla (`/#cobertura`,
 * ver src/data/navigation.ts) — mismo tratamiento que FeaturedWork.astro y Services.astro.
 */
import Section from '../layout/Section.astro';
import Badge from '../ui/Badge.astro';
import { resolveServiceAreas } from '../../data/areas';
import { coverageSectionContent, featuredAreaIds } from '../../data/coverageSection';

const featuredAreas = resolveServiceAreas(featuredAreaIds);
---

<Section as="section" id="cobertura" background="paper-2" spacing="lg" class="scroll-mt-24">
  <div class="flex flex-col gap-8">
    <div class="max-w-prose">
      <Badge>{coverageSectionContent.eyebrow}</Badge>
      <h2 class="text-ink mt-4 text-3xl font-black tracking-tight md:text-4xl">
        {coverageSectionContent.heading}
      </h2>
      <p class="text-ink-2 mt-4 text-lg">{coverageSectionContent.intro}</p>
    </div>

    <ul class="flex flex-wrap gap-3">
      {
        featuredAreas.map((area) => (
          <li>
            <Badge variant="neutral">{area.name}</Badge>
          </li>
        ))
      }
    </ul>

    <p class="text-ink-2 text-sm">{coverageSectionContent.note}</p>
  </div>
</Section>

---
import Section from '../layout/Section.astro';
import TechnicalNote from '../ui/TechnicalNote.astro';
import TextLink from '../ui/TextLink.astro';
import CaseEvidence from '../cases/CaseEvidence.astro';
import { buildCasePath, CASES_INDEX_PATH, getPublishedCaseById } from '../../lib/content/cases';
import { buildServicePath, getServiceBySlug } from '../../lib/content/services';
import { services } from '../../data/services';
import { getPlaceById } from '../../data/places';
import { featuredWorkContent } from '../../data/featuredWork';

const caseEntry = await getPublishedCaseById(featuredWorkContent.caseId);
const caseData = caseEntry?.data;

// Rótulo del enlace: el `title` del catálogo, el mismo que imprime la tarjeta
// de la sección Servicios. El href, en cambio, no se deriva del catálogo sino
// de la ficha publicada.
const service = caseData ? services.find((item) => item.id === caseData.service) : undefined;
const publishedService = caseData ? await getServiceBySlug(caseData.service) : undefined;
const serviceHref = publishedService ? buildServicePath(publishedService.id) : undefined;

// `area` es opcional en el schema. Si el caso no la declara no se muestra
// ubicación: no se infiere ni se rellena con una comuna genérica. Se resuelve
// contra el vocabulario geográfico (src/data/places.ts) y no contra el catálogo
// de cobertura: dónde ocurrió el trabajo es un hecho del caso, no una
// afirmación de dónde atiende el negocio. Un ID inexistente ya no llega hasta
// aquí — el enum del schema falla el build (ver src/content.config.ts#area).
const area = caseData?.area ? getPlaceById(caseData.area) : undefined;
---

{
  caseEntry && caseData && (
    <Section as="section" id="trabajos" background="paper" spacing="md" class="scroll-mt-24">
      <div class="evidence-stage border-hairline border-t pt-10">
        <div class="max-w-prose md:col-start-1 md:row-start-1">
          <TechnicalNote class="border-t-0 pt-0">{featuredWorkContent.eyebrow}</TechnicalNote>
          <h2 class="text-ink text-editorial mt-4 font-extrabold tracking-tight">
            {featuredWorkContent.heading}
          </h2>
          <p class="text-ink-2 mt-4 text-lg">{featuredWorkContent.intro}</p>
        </div>

        <div class="evidence-stage__media md:col-start-2 md:row-span-2 md:row-start-1">
          <CaseEvidence
            evidence={caseData.evidence}
            title={caseData.title}
            presentation="editorial"
          />
        </div>

        <div class="flex max-w-prose flex-col items-start gap-3 md:col-start-1 md:row-start-2">
          <h3 class="text-ink text-xl font-bold tracking-tight">
            <a
              href={buildCasePath(caseEntry.id)}
              class="hover:text-brand-ink underline-offset-4 transition-colors [transition-duration:var(--duration-micro)] hover:underline motion-reduce:transition-none"
            >
              {caseData.title}
            </a>
          </h3>

          <p class="text-ink-2">{caseData.shortDescription}</p>

          {area && (
            <p class="text-ink-2 text-sm">
              Trabajo realizado en {area.name}, {area.region}.
            </p>
          )}

          {serviceHref && service && (
            <TextLink href={serviceHref} class="mt-1">
              Ver el servicio: {service.title}
            </TextLink>
          )}

          <TextLink href={CASES_INDEX_PATH}>Ver todos los trabajos realizados</TextLink>
        </div>
      </div>
    </Section>
  )
}

<style>
  .evidence-stage {
    display: grid;
    gap: 2rem;
  }
  .evidence-stage__media {
    width: 100%;
    max-width: var(--media-portrait);
    justify-self: end;
  }
  @media (min-width: 48rem) {
    .evidence-stage {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      gap: 2rem var(--composition-gap);
    }
    .evidence-stage__media {
      max-width: var(--media-evidence);
    }
  }
</style>

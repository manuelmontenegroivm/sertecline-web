---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BeforeAfterComparatorIsland, { type AspectRatio } from './BeforeAfterComparatorIsland';

export interface ComparatorPair {
  before: ImageMetadata;
  after: ImageMetadata;
  caption?: string;
}

interface Props {
  presentation?: 'default' | 'editorial';
  pair: ComparatorPair;

  alt: string;

  beforeAlt?: string;
  afterAlt?: string;
  beforeLabel?: string;
  afterLabel?: string;

  aspectRatio?: AspectRatio;
}

const {
  pair,
  alt,
  beforeAlt,
  afterAlt,
  beforeLabel,
  afterLabel,
  aspectRatio,
  presentation = 'default',
} = Astro.props as Props;

// The editorial evidence stage grows to 480px; existing case/service views stay at 384px.
const DISPLAY_WIDTH = presentation === 'editorial' ? 480 : 384;

// Keep the compact candidate on mobile; never enlarge the approved original.
const candidateWidths = (image: ImageMetadata) =>
  [...new Set([384, DISPLAY_WIDTH, DISPLAY_WIDTH * 2].map((w) => Math.min(w, image.width)))].sort(
    (a, b) => a - b
  );

const SIZES =
  presentation === 'editorial'
    ? '(min-width: 64rem) 30rem, (min-width: 48rem) 44vw, (min-width: 26rem) 24rem, calc(100vw - 2rem)'
    : '(min-width: 48rem) 24rem, calc(100vw - 2rem)';

const [beforeImage, afterImage] = await Promise.all([
  getImage({
    src: pair.before,
    widths: candidateWidths(pair.before),
    sizes: SIZES,
    format: 'webp',
  }),
  getImage({
    src: pair.after,
    widths: candidateWidths(pair.after),
    sizes: SIZES,
    format: 'webp',
  }),
]);
---

<BeforeAfterComparatorIsland
  client:visible
  presentation={presentation}
  before={{
    src: beforeImage.src,
    width: beforeImage.attributes.width,
    height: beforeImage.attributes.height,
    srcSet: beforeImage.srcSet.attribute,
    sizes: SIZES,
  }}
  after={{
    src: afterImage.src,
    width: afterImage.attributes.width,
    height: afterImage.attributes.height,
    srcSet: afterImage.srcSet.attribute,
    sizes: SIZES,
  }}
  alt={alt}
  beforeAlt={beforeAlt}
  afterAlt={afterAlt}
  beforeLabel={beforeLabel}
  afterLabel={afterLabel}
  caption={pair.caption}
  aspectRatio={aspectRatio}
/>

---
/**
 * Wrapper del comparador antes/después (EPIC 3.6.1). Resuelve las imágenes
 * de un `pair` de la collection `cases` con getImage() en build/SSG: React
 * solo recibe props serializables (src/width/height planos), nunca el
 * ImageMetadata de Astro (decisión aprobada, ver CLAUDE.md).
 * No es full-bleed (vive dentro de <Container size="content"> a lo sumo a
 * media columna) — una sola densidad en formato moderno basta, sin srcset.
 * Hidratación client:visible: no es above-the-fold crítico (regla de
 * CLAUDE.md sobre directivas de cliente).
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BeforeAfterComparatorIsland, { type AspectRatio } from './BeforeAfterComparatorIsland';

export interface ComparatorPair {
  before: ImageMetadata;
  after: ImageMetadata;
  caption?: string;
}

interface Props {
  pair: ComparatorPair;
  /** Base del texto alternativo: se compone "<alt> — antes" / "<alt> — después". */
  alt: string;
  /**
   * Texto alternativo completo de cada imagen, cuando el caso declara uno
   * propio (ver `evidence.beforeAlt` / `evidence.resultAlt` en
   * src/content.config.ts). Sin ellos se mantiene el texto compuesto desde
   * `alt`, que es el comportamiento de todos los checkpoints anteriores.
   */
  beforeAlt?: string;
  afterAlt?: string;
  beforeLabel?: string;
  afterLabel?: string;
  /** Proporción del contenedor. @default 'natural' (proporción real de la imagen "after") */
  aspectRatio?: AspectRatio;
}

const { pair, alt, beforeAlt, afterAlt, beforeLabel, afterLabel, aspectRatio } =
  Astro.props as Props;

// Ancho objetivo del comparador en su uso más ancho. Se pide acotado al ancho
// real del original (EPIC 6 — Checkpoint 6.4): Sharp nunca amplía —ante un
// original más angosto devuelve el original—, pero getImage() sí construye sus
// `attributes` con el ancho PEDIDO. Con las fotografías de 720x1280 del caso
// publicado eso hacía que el archivo emitido midiera 720x1280 y el DOM
// declarara 960x1707: las dimensiones que el navegador usa para reservar el
// espacio no eran las de la imagen que recibía. Math.min() las vuelve a
// coincidir sin tocar el archivo generado (mismos bytes, mismo pixel) y sin
// introducir srcset ni una pipeline nueva. Un original más ancho que 960 sigue
// reduciéndose a 960 como antes.
const TARGET_WIDTH = 960;

const [beforeImage, afterImage] = await Promise.all([
  getImage({
    src: pair.before,
    width: Math.min(TARGET_WIDTH, pair.before.width),
    format: 'webp',
  }),
  getImage({
    src: pair.after,
    width: Math.min(TARGET_WIDTH, pair.after.width),
    format: 'webp',
  }),
]);
---

<BeforeAfterComparatorIsland
  client:visible
  before={{
    src: beforeImage.src,
    width: beforeImage.attributes.width,
    height: beforeImage.attributes.height,
  }}
  after={{
    src: afterImage.src,
    width: afterImage.attributes.width,
    height: afterImage.attributes.height,
  }}
  alt={alt}
  beforeAlt={beforeAlt}
  afterAlt={afterAlt}
  beforeLabel={beforeLabel}
  afterLabel={afterLabel}
  caption={pair.caption}
  aspectRatio={aspectRatio}
/>

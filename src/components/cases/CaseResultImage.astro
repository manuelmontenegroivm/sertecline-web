---
/**
 * Fotografía del resultado de un Case, estática (EPIC 7 — Checkpoint 7.3).
 *
 * Existe porque dos superficies muestran esta misma imagen con la misma regla y
 * distinto tamaño: CaseEvidence, cuando el caso no tiene fotografía previa, y
 * CaseCard, siempre —el índice de trabajos no hidrata un comparador por
 * tarjeta—. Lo que se centraliza son las dos reglas del dominio, no un sistema
 * de imágenes:
 *
 *   1. El ancho pedido se acota al ancho real del original (`Math.min`). Sharp
 *      nunca amplía, pero getImage()/<Image> sí construyen los atributos con el
 *      ancho PEDIDO: sin este tope el DOM declararía dimensiones que el archivo
 *      emitido no tiene y el navegador reservaría un espacio equivocado. Misma
 *      razón y misma forma que BeforeAfterComparator.astro (EPIC 6 — CP 6.4).
 *   2. El texto alternativo se compone desde el título del caso —"<título> —
 *      resultado"— salvo que el propio caso declare `resultAlt`. Es la regla que
 *      ya aplicaba CaseEvidence; ahora la aplica un solo archivo para las dos
 *      superficies, así que no pueden divergir.
 *
 * NO decide proporción, recorte ni contenedor: emite la imagen con su
 * proporción real (`width`/`height` del original, sin `aspect-ratio` ni
 * `object-fit`) y quien la compone define cuánto mide y cómo se recorta el
 * espacio a su alrededor. En este sitio el recorte cuesta evidencia — ver el
 * bloque PROPORCIÓN de FeaturedWork.astro y ServiceCase.astro.
 *
 * Sin `widths` ni `densities`: una sola densidad en formato moderno, sin
 * srcset, como el resto del pipeline de casos.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props extends Omit<astroHTML.JSX.ImgHTMLAttributes, 'src' | 'width' | 'height' | 'alt'> {
  result: ImageMetadata;
  /** Título del caso: base del texto alternativo cuando la evidencia no declara uno. */
  title: string;
  /** `evidence.resultAlt` del caso, si lo declara — ver src/content.config.ts. */
  resultAlt?: string;
  /** Ancho objetivo en px. Se acota al ancho real del original. */
  width: number;
}

const { result, title, resultAlt, width, ...rest } = Astro.props as Props;
---

<Image
  src={result}
  width={Math.min(width, result.width)}
  format="webp"
  alt={resultAlt ?? `${title} — resultado`}
  loading="lazy"
  decoding="async"
  {...rest}
/>

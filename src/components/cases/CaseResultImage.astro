---
/**
 * Real result, natural ratio, no crop or enlargement of the approved source.
 * Alt uses the case override or its existing title. Optional responsive widths
 * serve the CP 9.2 Hero and Work Strip; CaseEvidence keeps its current default.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props extends Omit<astroHTML.JSX.ImgHTMLAttributes, 'src' | 'width' | 'height' | 'alt'> {
  result: ImageMetadata;
  /** Título del caso: base del texto alternativo cuando la evidencia no declara uno. */
  title: string;
  /** `evidence.resultAlt` del caso, si lo declara — ver src/content.config.ts. */
  resultAlt?: string;
  /** Ancho objetivo en px. Se acota al ancho real del original. */
  width: number;
  /** Optional responsive candidates, capped to the approved source. */
  widths?: number[];
}

const { result, title, resultAlt, width, widths, ...rest } = Astro.props as Props;
---

<Image
  src={result}
  width={Math.min(width, result.width)}
  widths={widths && [...new Set(widths.map((candidate) => Math.min(candidate, result.width)))]}
  format="webp"
  alt={resultAlt ?? `${title} — resultado`}
  loading="lazy"
  decoding="async"
  {...rest}
/>

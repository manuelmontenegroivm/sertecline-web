---
/**
 * Layout base del sitio: documento HTML, metadata SEO/OG/Twitter, favicons
 * y activación del design system. Header sticky incluido (EPIC 3.5 — Core
 * Experience). Footer incluido (EPIC 4.1 — Checkpoint 4.1.17): va después de
 * </main> y fuera de él, de modo que su landmark `contentinfo` no quede
 * anidado dentro del contenido principal.
 * Landmark <main> + skip link agregados en el checkpoint correctivo de
 * cierre de EPIC 3.5 (auditoría de accesibilidad).
 */
import '../styles/global.css';
import { siteConfig } from '../config/site';
import { seoDefaults } from '../config/seo';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  /** Título de página (sin el sufijo " | Sertecline", se agrega automáticamente). */
  title?: string;
  description?: string;
  /** Ruta absoluta o relativa a `siteConfig.url` de la imagen para OG/Twitter. */
  image?: string;
  /** URL canónica completa. Por defecto se deriva de `Astro.url` + `astro.config.mjs#site`. */
  canonical?: string;
  /** Excluye la página de indexación (borradores, páginas utilitarias). @default false */
  noindex?: boolean;
}

const {
  title,
  description = seoDefaults.defaultDescription,
  image = seoDefaults.defaultImage,
  canonical = new URL(Astro.url.pathname, Astro.site ?? siteConfig.url).toString(),
  noindex = false,
} = Astro.props;

const pageTitle = title ? seoDefaults.titleTemplate.replace('%s', title) : seoDefaults.defaultTitle;
const ogImage = new URL(image, siteConfig.url).toString();
const ogLocale = seoDefaults.locale.replace('-', '_');
---

<!doctype html>
<html lang={siteConfig.defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicons & PWA — public/brand/ (EPIC 3.1 Brand Asset System) -->
    <link rel="icon" type="image/svg+xml" href="/brand/favicon/favicon.svg" />
    <link rel="icon" href="/brand/favicon/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/brand/site.webmanifest" />
    <meta name="theme-color" content={siteConfig.themeColor} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Tipografía de marca -->
    {
      /* Archivo, self-hosted desde EPIC 8 — Checkpoint 8.3 (F-03). Las
        @font-face viven en src/styles/brand.css y los archivos en
        public/fonts/, así que aquí ya no hay hoja de estilos de terceros en la
        ruta crítica de render ni preconnects al CDN de Google. Este preload es
        lo único que queda: la fuente se descubre DENTRO del CSS, o sea un
        round-trip después de que el CSS llega, y adelantarlo evita ese salto
        del texto que el `swap` produciría. Solo Archivo — JetBrains Mono no
        tiene consumidores y precargarla sería pedir bytes que ninguna página
        usa (ver la nota en brand.css). Va como comentario de expresión y no
        como comentario HTML porque explica el código, no el documento: así no
        viaja en las nueve páginas servidas. */
    }
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main-content"
      class="border-hairline bg-paper text-ink fixed top-4 left-4 z-[var(--z-tooltip)] -translate-y-full rounded-md border px-4 py-2 text-sm font-medium opacity-0 shadow-md transition [transition-duration:var(--duration-base)] [transition-timing-function:var(--ease-out)] focus:translate-y-0 focus:opacity-100"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
/**
 * Estructura visual base de una ficha de servicio (EPIC 4.0 — Checkpoint 6).
 * Hero (header) + área de contenido MDX. Reutiliza <Container> de
 * components/layout/ para anchos (max-w-content/narrow generados desde
 * --container-* en tokens.css) en vez de duplicar valores.
 *
 * SEO (Checkpoint 8): este layout es el único punto compartido por todas las
 * páginas de servicio, así que aquí se compone título/descripción SEO a
 * partir de los datos crudos de catálogo + contenido editorial, vía
 * src/lib/seo/services.ts. La ruta ([slug].astro) solo resuelve datos; no
 * conoce la estrategia SEO.
 *
 * Datos estructurados (Checkpoint 9): el JSON-LD se inyecta aquí y sirve a
 * cualquier ficha de servicio, presente y futura. Este archivo solo cablea —
 * pide el string ya serializado a lib/seo/services.ts, no construye objetos
 * schema.org. La canónica se calcula una vez y se pasa a BaseLayout para que
 * <link rel="canonical"> y el @id del JSON-LD no puedan divergir.
 *
 * FAQs (Checkpoint 10): un único array `faqs` alimenta a la vez la sección
 * visible y el nodo FAQPage del mismo @graph. No hay una segunda fuente para
 * lo estructurado, así que no puede declararse una pregunta que la página no
 * muestre. Sin preguntas no hay sección ni nodo.
 *
 * Breadcrumbs (Checkpoint 11): mismo principio. Una sola constante
 * `breadcrumbs` se recorre para el <ol> visible y se pasa al @graph, de modo
 * que el rastro estructurado no pueda declarar una jerarquía distinta de la
 * que se muestra.
 *
 * CTA (Checkpoint 12): <ServiceCta> cierra el <article> después de las FAQs.
 * Al ser este el único punto compartido por todas las fichas, toda ficha —
 * presente o futura — termina con una salida de contacto sin repetir nada en
 * el MDX. No aporta datos estructurados propios.
 *
 * CONTACTO TEMPRANO (EPIC 6 — Checkpoint 6.2). El audit de CP 6.1 midió que la
 * primera acción de contacto de la página estaba entre 2.833px y 3.277px en un
 * móvil de 390px —entre 3,4 y 3,9 pantallas de scroll—, porque <ServiceCta> era
 * la única salida y cierra el artículo. Quien llega desde una búsqueda ya
 * decidido no tenía dónde escribir sin recorrer la ficha entera.
 *
 * El hero incorpora ahora <ContactActions>, el mismo par WhatsApp + teléfono
 * que usan la sección Contacto de home y el CTA de cierre. No es una segunda
 * primitiva ni un CTA duplicado: aquí va **sin encabezado ni copy propio**,
 * como afordancia del encabezado de página («ya sé qué necesito»), mientras
 * <ServiceCta> conserva su rótulo, su h2 y su intro como cierre del contenido
 * («leíste todo, hablemos»). Son dos funciones distintas del journey y se
 * distinguen por composición, no por dos bloques iguales repetidos.
 * <ContactActions> documenta que asume fondo `paper-2` para el override de su
 * botón secundario: este <header> ya lo tiene, así que ese componente no
 * cambia.
 *
 * El mensaje precargado de WhatsApp se construye **una sola vez aquí** y se
 * pasa a las dos acciones. Antes lo interpolaba <ServiceCta> con el
 * `serviceName` recibido; con dos consumidores, hacerlo dos veces habilitaría
 * que el mensaje del hero y el del cierre divergieran al editar uno solo. Es el
 * mismo criterio con el que `serviceName`, `breadcrumbs` y `canonical` se
 * resuelven una vez en este archivo y se comparten.
 *
 * Caso relacionado (Checkpoint 13): `relatedCases` llega ya resuelto y ordenado
 * desde la ruta (mismo criterio que `faqs`: la ruta resuelve datos, el layout
 * compone). El bloque se recorre como lista y no asume una cantidad, aunque hoy
 * la ruta pida uno solo. Va fuera del contenedor `.service-content` porque las
 * reglas `:global()` de ese contenedor están pensadas para prosa MDX.
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import FaqItem from '../components/faq/FaqItem.astro';
import ServiceCase from '../components/cases/ServiceCase.astro';
import ServiceCta from '../components/services/ServiceCta.astro';
import ContactActions from '../components/contact/ContactActions.astro';
import { serviceCasesContent } from '../data/serviceCases';
import { serviceCtaContent } from '../data/serviceCta';
import {
  buildServiceSeoTitle,
  buildServiceMetaDescription,
  buildServiceBreadcrumbs,
  buildServiceCanonicalUrl,
  buildServiceStructuredData,
  resolveServiceName,
} from '../lib/seo/services';
import type { ServiceFaq } from '../types/serviceFaq';

interface Props {
  title: string;
  /** Override opcional del catálogo — ver src/data/services.ts#seoTitle. */
  seoTitle?: string;
  intro: string;
  metaDescription: string;
  /** Frontmatter `faqs` de la ficha, tal cual — ver src/content.config.ts. */
  faqs?: readonly ServiceFaq[];
  /** Casos ya filtrados y ordenados — ver src/lib/content/cases.ts#getRelatedCases. */
  relatedCases?: readonly CollectionEntry<'cases'>[];
}

const { title, seoTitle, intro, metaDescription, faqs = [], relatedCases = [] } = Astro.props;

// Resuelto una sola vez: el <h1>, el <title>, el nombre del Service y el
// último tramo del rastro son la misma denominación, no cuatro decisiones
// independientes. El `title` del catálogo se reserva para UI compacta (Badge,
// ServiceCard); una ficha completa no tiene esa restricción de espacio.
const serviceName = resolveServiceName(title, seoTitle);

// Un único mensaje contextual para las dos acciones de contacto de la ficha
// (hero y cierre) — ver el bloque CONTACTO TEMPRANO arriba. La plantilla vive
// en src/data/serviceCta.ts junto al resto del copy de contacto de la ficha.
const whatsappMessage = serviceCtaContent.whatsappMessageTemplate.replace(
  '{servicio}',
  serviceName
);

const pageTitle = buildServiceSeoTitle(title, seoTitle);
const pageDescription = buildServiceMetaDescription(metaDescription);
const canonical = buildServiceCanonicalUrl(Astro.url.pathname, Astro.site);
const breadcrumbs = buildServiceBreadcrumbs(serviceName);
const structuredData = buildServiceStructuredData({
  name: serviceName,
  description: metaDescription,
  canonical,
  faqs,
  breadcrumbs,
});
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonical}>
  <!-- is:inline explícito: JSON-LD es datos, no un script a procesar/bundlear. -->
  <script type="application/ld+json" slot="head" is:inline set:html={structuredData} />
  <article>
    <header class="border-hairline bg-paper-2 border-b">
      {
        /* `narrow` y no `content`: el h1 y el intro ya se acotaban a
          max-w-narrow dentro de un contenedor de 1200px, así que su medida no
          cambia, pero su borde izquierdo pasa a coincidir con el del cuerpo
          MDX, el caso, las FAQ y el CTA —todos `narrow`—. Medido en CP 6.1: a
          1440px el hero arrancaba en x=137 y todo lo demás en x=377, 240px de
          desfase. Con la acción de contacto ahora dentro del hero ese desfase
          dejaba de ser un detalle de composición: los botones quedaban
          colgando a la izquierda de la columna a la que pertenecen. */
      }
      <Container size="narrow" class="py-16 md:py-24">
        {
          /* Separador dentro del <li> y no como item propio: un <li> decorativo
            alteraría el conteo de elementos que anuncia el lector de pantalla. */
        }
        <nav aria-label="Breadcrumb" class="mb-6">
          <ol class="text-ink-2 flex flex-wrap items-center gap-2 text-sm">
            {
              breadcrumbs.map((crumb, index) => (
                <li class="flex items-center gap-2">
                  {index > 0 && (
                    <span aria-hidden="true" class="text-ink-3">
                      /
                    </span>
                  )}
                  {crumb.href ? (
                    <a
                      href={crumb.href}
                      class="hover:text-ink focus-visible:ring-brand-ink rounded-sm underline-offset-2 hover:underline focus-visible:ring-2 focus-visible:outline-none"
                    >
                      {crumb.name}
                    </a>
                  ) : (
                    <span aria-current="page" class="text-ink font-medium">
                      {crumb.name}
                    </span>
                  )}
                </li>
              ))
            }
          </ol>
        </nav>
        <h1 class="text-ink text-3xl font-black tracking-tight md:text-4xl">
          {serviceName}
        </h1>
        <p class="text-ink-2 mt-4 text-lg leading-relaxed md:mt-6">
          {intro}
        </p>
        {
          /* Sin encabezado ni copy propio: los rótulos de los dos enlaces ya
            dicen qué hacen, y añadir un titular aquí crearía un segundo bloque
            de CTA compitiendo con el cierre. La separación (mt-8/mt-10, contra
            los mt-4/mt-6 del intro) es lo que lo despega del párrafo y evita
            que se lea como una tercera línea de texto. */
        }
        <div class="mt-8 md:mt-10">
          <ContactActions whatsappMessage={whatsappMessage} />
        </div>
      </Container>
    </header>

    <!-- Contenido MDX: empieza en h2 (el h1 ya lo ocupa el hero). -->
    <Container size="narrow" class="service-content py-12 md:py-16">
      <slot />
    </Container>

    {
      /* Evidencia entre la explicación (MDX) y las objeciones (FAQ). El h2 de
         sección deja el h1 del hero arriba y el h3 de cada caso abajo, sin
         saltos de nivel. Sin <Badge> del servicio dentro de cada caso: en esta
         página ese dato ya es el h1. */
      relatedCases.length > 0 && (
        <section aria-labelledby="caso-relacionado" class="border-hairline border-t">
          <Container size="narrow" class="py-12 md:py-16">
            <h2
              id="caso-relacionado"
              class="text-ink text-2xl font-bold tracking-tight md:text-3xl"
            >
              {serviceCasesContent.heading}
            </h2>
            {serviceCasesContent.intro && (
              <p class="text-ink-2 mt-4 text-lg">{serviceCasesContent.intro}</p>
            )}
            <div class="mt-8 flex flex-col gap-12">
              {relatedCases.map((caseEntry) => (
                <ServiceCase case={caseEntry} />
              ))}
            </div>
          </Container>
        </section>
      )
    }

    {
      /* Mismo nivel que los h2 del MDX: el h1 es el hero y FaqItem aporta el
         h3 de cada pregunta, así que la jerarquía queda h1 → h2 → h3 sin
         saltos. FaqItem usa <details> nativo — sin JS de cliente, y con la
         respuesta en el DOM inicial aunque esté colapsada. */
      faqs.length > 0 && (
        <section aria-labelledby="preguntas-frecuentes" class="border-hairline border-t">
          <Container size="narrow" class="py-12 md:py-16">
            <h2
              id="preguntas-frecuentes"
              class="text-ink text-2xl font-bold tracking-tight md:text-3xl"
            >
              Preguntas frecuentes
            </h2>
            <div class="mt-6 md:mt-8">
              {faqs.map((faq) => (
                <FaqItem question={faq.question} answer={faq.answer} />
              ))}
            </div>
          </Container>
        </section>
      )
    }

    <ServiceCta whatsappMessage={whatsappMessage} />
  </article>
</BaseLayout>

<style>
  /* Contenido inyectado vía <slot/> desde MDX: no hereda el scope de este
     componente, por eso :global(). Cubre h2–h4/p/listas/enlaces/imágenes/
     blockquote ahora (aunque el MDX actual solo use <p>) para que futuros
     checkpoints de contenido (imágenes, listas, bloques informativos) no
     requieran tocar este layout. */
  .service-content :global(> *:first-child) {
    margin-top: 0;
  }

  .service-content :global(h2) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-size: var(--text-2xl);
    line-height: var(--text-2xl--line-height);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .service-content :global(h3) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    font-size: var(--text-xl);
    line-height: var(--text-xl--line-height);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--tracking-tight);
    color: var(--color-ink);
  }

  .service-content :global(h4) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
  }

  .service-content :global(p) {
    margin-bottom: 1.5rem;
    font-size: var(--text-base);
    line-height: var(--text-base--line-height);
    color: var(--color-ink-2);
  }

  .service-content :global(ul),
  .service-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    color: var(--color-ink-2);
  }

  .service-content :global(ul) {
    list-style-type: disc;
  }

  .service-content :global(ol) {
    list-style-type: decimal;
  }

  .service-content :global(li + li) {
    margin-top: 0.5rem;
  }

  .service-content :global(a) {
    color: var(--color-brand-ink);
    text-underline-offset: 2px;
    text-decoration: underline;
  }

  .service-content :global(strong) {
    font-weight: var(--font-weight-semibold);
    color: var(--color-ink);
  }

  .service-content :global(blockquote) {
    margin-bottom: 1.5rem;
    border-left: var(--border-accent) solid var(--color-hairline-strong);
    padding-left: 1rem;
    color: var(--color-ink-2);
    font-style: italic;
  }

  .service-content :global(img) {
    margin-top: 2rem;
    margin-bottom: 2rem;
    width: 100%;
    border-radius: var(--radius-lg);
  }

  .service-content :global(hr) {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    border-color: var(--color-hairline);
  }
</style>
